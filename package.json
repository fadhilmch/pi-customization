{
  "name": "pi-customization",
  "version": "0.1.0",
  "description": "Pi coding agent extensions and themes: Claude Code look, auto-mode permissions, plan mode, todos, subagents, rewind checkpoints, notifications and format/typecheck on write.",
  "private": true,
  "license": "MIT",
  "author": "Fadhil Mochammad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadhilmch/pi-customization.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extensions",
    "themes"
  ],
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ],
    "prompts": [
      "./prompts/*.md",
      "./extensions/*/prompts/*.md"
    ],
    "themes": [
      "./themes/*.json",
      "./extensions/*/themes/*.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test \"extensions/*/tests/*.test.js\" \"tests/*.test.js\""
  },
  "homepage": "https://github.com/fadhilmch/pi-customization#readme",
  "bugs": {
    "url": "https://github.com/fadhilmch/pi-customization/issues"
  },
  "engines": {
    "node": ">=22.6"
  }
}
